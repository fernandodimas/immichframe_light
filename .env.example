# Immich Frame - Environment Variables
# Copy this file to .env and fill in the values

# URL base do servidor Immich (ex: http://192.168.1.50:2283)
IMMICH_URL=http://192.168.1.50:2283

# Chave de API do usuario Immich
IMMICH_API_KEY=your_api_key_here

# UUID do album alvo
IMMICH_ALBUM_ID=your_album_uuid_here

# Intervalo entre fotos em segundos (padrao: 15)
INTERVAL_SECONDS=15
