# Immich Frame - Environment Variables
# Copy this file to .env and fill in the values

# === REQUIRED ===

# URL base do servidor Immich (ex: http://192.168.1.50:2283)
IMMICH_URL=http://192.168.1.50:2283

# Chave de API do usuario Immich
# Obter em: User Settings > API Keys
IMMICH_API_KEY=your_api_key_here

# UUID do album alvo
# Obter na URL do album: /albums/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
IMMICH_ALBUM_ID=your_album_uuid_here


# === SLIDESHOW SETTINGS ===

# Intervalo entre fotos em segundos (padrao: 20)
INTERVAL_SECONDS=20

# Duracao da transicao em segundos (padrao: 2)
TRANSITION_DURATION=2

# Embaralhar fotos (true/false, padrao: true)
SHUFFLE=true


# === DISPLAY SETTINGS ===

# Mostrar relogio (true/false, padrao: true)
SHOW_CLOCK=true

# Formato do relogio (padrao: HH:mm)
# Opcoes: HH:mm, hh:mm a, HH:mm:ss
CLOCK_FORMAT=HH:mm

# Formato da data no relogio (padrao:eeee, d 'de' MMMM 'de' yyyy)
CLOCK_DATE_FORMAT=eeee, d 'de' MMMM 'de' yyyy

# Mostrar barra de progresso (true/false, padrao: true)
SHOW_PROGRESS_BAR=true

# Mostrar data da foto (true/false, padrao: true)
SHOW_PHOTO_DATE=true

# Formato da data da foto (padrao: dd/MM/yyyy)
PHOTO_DATE_FORMAT=dd/MM/yyyy

# Mostrar descricao da imagem (true/false, padrao: true)
SHOW_IMAGE_DESC=true

# Mostrar nomes das pessoas (true/false, padrao: true)
SHOW_PEOPLE_DESC=true

# Mostrar nome do album (true/false, padrao: true)
SHOW_ALBUM_NAME=true

# Mostrar localizacao da foto (true/false, padrao: true)
SHOW_IMAGE_LOCATION=true

# Idioma para tempo e interface (padrao: pt)
# Opcoes: pt, en, es, fr, de
LANGUAGE=pt


# === IMAGE EFFECTS ===

# Zoom na imagem efeito Ken Burns (true/false, padrao: true)
IMAGE_ZOOM=true

# Mover a imagem em direcao aleatoria (true/false, padrao: false)
IMAGE_PAN=false

# Preencher espaco disponivel (pode recortar, true/false, padrao: false)
IMAGE_FILL=false


# === STYLE SETTINGS ===

# Cor principal da interface (hex, padrao: #f5deb3)
PRIMARY_COLOR=#f5deb3

# Cor secundaria da interface (hex, padrao: #000000)
SECONDARY_COLOR=#000000

# Estilo de fundo (padrao: none)
# Opcoes: none, solid, transition, blur
STYLE=none

# Tamanho da fonte base (padrao: 17px)
BASE_FONT_SIZE=17px

# Formato da localizacao (padrao: City,State,Country)
IMAGE_LOCATION_FORMAT=City,State,Country


# === WEATHER SETTINGS ===

# Chave de API do OpenWeatherMap (obter em: https://openweathermap.org/api)
# Se nao configurado, o tempo nao sera exibido
WEATHER_API_KEY=

# Sistema de unidades (padrao: metric)
# Opcoes: metric (Celsius), imperial (Fahrenheit)
UNIT_SYSTEM=metric

# Localizacao do tempo (latitude,longitude)
# Exemplo: Sao Paulo: -23.5505,-46.6333
WEATHER_LAT_LONG=-23.5505,-46.6333

# Mostrar descricao do tempo (true/false, padrao: true)
SHOW_WEATHER_DESCRIPTION=true


# === NIGHT MODE ===

# Ativar modo noturno (tela preta) (true/false, padrao: false)
NIGHT_MODE=false

# Hora de inicio do modo noturno (HH:mm, padrao: 22:00)
NIGHT_MODE_START=22:00

# Hora de fim do modo noturno (HH:mm, padrao: 07:00)
NIGHT_MODE_END=07:00


# === TIMEZONE ===

# Fuso horario (offset UTC em horas, padrao: horario do servidor)
# Exemplos: -3 (Brasilia), -5 (Nova York), 1 (Londres)
TIMEZONE=-3
